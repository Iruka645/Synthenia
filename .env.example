# Synthenia local-first defaults
SYNTHENIA_MODE=local
HOST=127.0.0.1
PORT=4040
ALLOWED_ORIGINS=http://localhost:6060,http://127.0.0.1:6060

# Required for protected resource/control-panel routes
CONTROL_PANEL_API_KEY=replace-with-a-long-random-value

# Resource limits
MAX_JSON_BODY=64kb
MAX_URLENCODED_BODY=32kb
MAX_AUDIO_UPLOAD_MB=20
AUDIO_RETENTION_HOURS=24
UPLOAD_RETENTION_MINUTES=15

# Existing runtime settings are documented in backend/.env (never commit secrets)
AI_MODEL=gemma4:12b
VOICE_CONVERSION_ENABLED=false
